<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SmcTrader" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/bg</item>
        <item name="colorSecondaryContainer">@color/accent_soft</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/surface_2</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="colorError">@color/sell</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialAlertDialogTheme">@style/Theme.SmcTrader.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/Theme.SmcTrader.BottomSheet</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.SmcTrader.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_2</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
    </style>

    <style name="Theme.SmcTrader.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.SmcTrader.BottomSheet</item>
    </style>

    <style name="Widget.SmcTrader.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/Shape.SmcTrader.Sheet</item>
    </style>

    <style name="Shape.SmcTrader.Sheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">22dp</item>
        <item name="cornerSizeTopRight">22dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.SmcTrader.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">@dimen/space_16</item>
    </style>

    <style name="Widget.SmcTrader.Card.Raised" parent="Widget.SmcTrader.Card">
        <item name="cardBackgroundColor">@color/surface_2</item>
        <item name="strokeColor">@color/stroke</item>
    </style>

    <style name="Widget.SmcTrader.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.SmcTrader.Button.Buy" parent="Widget.SmcTrader.Button">
        <item name="backgroundTint">@color/buy</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.SmcTrader.Button.Sell" parent="Widget.SmcTrader.Button">
        <item name="backgroundTint">@color/sell</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.SmcTrader.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.SmcTrader.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/surface_2</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="chipStrokeColor">@color/stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">10dp</item>
        <item name="android:textSize">11sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">30dp</item>
    </style>

    <style name="Widget.SmcTrader.Badge" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/primary_soft</item>
        <item name="android:textColor">@color/primary</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">8dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipMinHeight">24dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="TextAppearance.SmcTrader.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.SmcTrader.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.SmcTrader.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.SmcTrader.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SmcTrader.Number" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="TextAppearance.SmcTrader.Number.Big" parent="TextAppearance.SmcTrader.Number">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SmcTrader.Number.Hero" parent="TextAppearance.SmcTrader.Number">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Widget.SmcTrader.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_2</item>
        <item name="boxStrokeColor">@color/stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <style name="Widget.SmcTrader.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/surface_2</item>
        <item name="boxStrokeColor">@color/stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>

    <style name="Widget.SmcTrader.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/stroke_soft</item>
    </style>

    <style name="Widget.SmcTrader.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.SmcTrader.NavIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemPaddingTop">6dp</item>
        <item name="itemPaddingBottom">6dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.SmcTrader.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_soft</item>
        <item name="shapeAppearance">@style/Shape.SmcTrader.NavPill</item>
    </style>

    <style name="Shape.SmcTrader.NavPill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
</resources>
