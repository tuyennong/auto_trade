<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_20">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_14"
            android:text="@string/settings_title"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_14"
            android:letterSpacing="0.1"
            android:text="@string/settings_mt5"
            android:textAllCaps="true"
            android:textColor="@color/text_dim"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_card_soft"
            android:orientation="vertical"
            android:padding="@dimen/space_12">

            <TextView
                android:id="@+id/tv_settings_mt5_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_settings_mt5_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="1dp"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_settings_mt5"
                style="@style/Widget.SmcTrader.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/space_10"
                android:minHeight="44dp"
                android:text="@string/mt5_login_action"
                app:icon="@drawable/ic_account"
                app:iconGravity="textStart" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_14"
            android:letterSpacing="0.1"
            android:text="@string/settings_account"
            android:textAllCaps="true"
            android:textColor="@color/text_dim"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.SmcTrader.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:hint="@string/settings_balance">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_settings_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="numberDecimal"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.SmcTrader.TextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/settings_leverage">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_settings_leverage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:inputType="number"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <Space
                android:layout_width="@dimen/space_8"
                android:layout_height="1dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.SmcTrader.TextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/settings_risk">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_settings_risk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.SmcTrader.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:hint="@string/settings_commission">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_settings_commission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="numberDecimal"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings_save"
            style="@style/Widget.SmcTrader.Button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/save"
            app:backgroundTint="@color/primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/space_14"
            android:background="@color/stroke_soft" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_account"
            style="@style/Widget.SmcTrader.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/settings_reset_account"
            android:textColor="@color/sell"
            app:icon="@drawable/ic_reset"
            app:iconGravity="textStart"
            app:iconTint="@color/sell"
            app:strokeColor="@color/sell" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:letterSpacing="0.1"
            android:text="@string/settings_about"
            android:textAllCaps="true"
            android:textColor="@color/text_dim"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_settings_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:lineSpacingExtra="2dp"
            android:text="@string/settings_about_body"
            android:textColor="@color/text_dim"
            android:textSize="10.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="@string/settings_version"
            android:textColor="@color/text_muted"
            android:textSize="9.5sp" />
    </LinearLayout>
</ScrollView>
